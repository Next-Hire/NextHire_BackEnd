<#@ template hostSpecific="true" #>
<#@ assembly name="Microsoft.EntityFrameworkCore" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Design" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Relational" #>
<#@ assembly name="Microsoft.Extensions.DependencyInjection.Abstractions" #>
<#@ assembly name="Npgsql" #>
<#@ parameter name="EntityType" type="Microsoft.EntityFrameworkCore.Metadata.IEntityType" #>
<#@ parameter name="Options" type="Microsoft.EntityFrameworkCore.Scaffolding.ModelCodeGenerationOptions" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="Microsoft.EntityFrameworkCore" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Design" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Metadata" #>
<#@ import namespace="Microsoft.Extensions.DependencyInjection" #>
<#@ import namespace="Npgsql" #>
<#
    // Tabelas de junção N:N simples não viram classe: o DbContext as configura
    // via UsingEntity (mesmo comportamento do template padrão do EF Core).
    if (EntityType.IsSimpleManyToManyJoinEntityType())
    {
        return "";
    }

    var services = (IServiceProvider)Host;
    var code = services.GetRequiredService<ICSharpHelper>();

    var modelNamespace = !string.IsNullOrWhiteSpace(Options.ModelNamespace)
        ? Options.ModelNamespace
        : Options.RootNamespace + ".Domains";

    var useNrt = Options.UseNullableReferenceTypes;

    var tableName = EntityType.GetTableName();
    var tableSchema = EntityType.GetSchema() ?? DefaultSchema;

    // Colunas enum do PostgreSQL desta tabela. O scaffold do Npgsql PULA essas
    // colunas, então elas não existem em EntityType.GetProperties().
    var enumColumns = tableName == null
        ? new List<PgEnumColumn>()
        : LoadEnumColumns(Options.ConnectionString, tableSchema, tableName);
#>
// <auto-generated />
using System;
using System.Collections.Generic;

namespace <#= modelNamespace #>;

public partial class <#= code.Identifier(EntityType.Name) #>
{
<#
    foreach (var property in EntityType.GetProperties())
    {
        var propertyType = code.Reference(property.ClrType);

        if (useNrt && property.IsNullable && !property.ClrType.IsValueType)
        {
            propertyType += "?";
        }

        var initializer = useNrt && !property.IsNullable && !property.ClrType.IsValueType
            ? " = null!;"
            : "";
#>
    public <#= propertyType #> <#= code.Identifier(property.Name) #> { get; set; }<#= initializer #>

<#
    }

    // ---------------------------------------------------------------
    // Propriedades enum (lidas do catálogo do PostgreSQL)
    // ---------------------------------------------------------------
    foreach (var column in enumColumns)
    {
        var propertyName = ToPascal(column.ColumnName);

        // Se uma versão futura do provider passar a escanear a coluna, não duplica.
        if (EntityType.GetProperties().Any(p => p.Name == propertyName))
        {
            continue;
        }

        var enumType = EnumClassName(column.EnumSchema, column.EnumName);
        var propertyType = column.NotNull ? enumType : enumType + "?";
#>
    public <#= propertyType #> <#= code.Identifier(propertyName) #> { get; set; }

<#
    }

    // ---------------------------------------------------------------
    // Navegações (alvo = Name da entidade, nunca ClrType)
    // ---------------------------------------------------------------
    foreach (var navigation in EntityType.GetNavigations())
    {
        var targetType = navigation.TargetEntityType.Name;

        if (navigation.IsCollection)
        {
#>
    public virtual ICollection<<#= targetType #>> <#= code.Identifier(navigation.Name) #> { get; set; } = new List<<#= targetType #>>();

<#
        }
        else
        {
            var isRequired = navigation.IsOnDependent && navigation.ForeignKey.IsRequired;

            if (!useNrt)
            {
#>
    public virtual <#= targetType #> <#= code.Identifier(navigation.Name) #> { get; set; }

<#
            }
            else if (isRequired)
            {
#>
    public virtual <#= targetType #> <#= code.Identifier(navigation.Name) #> { get; set; } = null!;

<#
            }
            else
            {
#>
    public virtual <#= targetType #>? <#= code.Identifier(navigation.Name) #> { get; set; }

<#
            }
        }
    }

    // ---------------------------------------------------------------
    // Navegações N:N (tabelas de junção simples)
    // ---------------------------------------------------------------
    foreach (var skipNavigation in EntityType.GetSkipNavigations())
    {
        var targetType = skipNavigation.TargetEntityType.Name;
#>
    public virtual ICollection<<#= targetType #>> <#= code.Identifier(skipNavigation.Name) #> { get; set; } = new List<<#= targetType #>>();

<#
    }
#>
}
<#+
    // =====================================================================
    // Auxiliares. DbContext.t4 contém uma cópia destes mesmos métodos:
    // mantenha as duas em sincronia (a diretiva include do T4 não é
    // confiável no host do EF). NUNCA escreva o marcador de fim de bloco
    // do T4 dentro de comentários: ele encerra o bloco.
    // =====================================================================

    private const string DefaultSchema = "public";

    private sealed class PgEnumColumn
    {
        public string TableSchema { get; set; } = "";
        public string TableName { get; set; } = "";
        public string ColumnName { get; set; } = "";
        public string EnumSchema { get; set; } = "";
        public string EnumName { get; set; } = "";
        public bool NotNull { get; set; }
    }

    private static string ToPascal(string value)
    {
        var parts = Regex.Split(value, @"[^\p{L}\p{Nd}]+").Where(x => x.Length > 0);
        var result = string.Concat(parts.Select(x => char.ToUpperInvariant(x[0]) + x.Substring(1)));

        if (result.Length == 0) result = "Value";
        if (char.IsDigit(result[0])) result = "_" + result;

        return result;
    }

    private static string EnumClassName(string schema, string name)
        => schema == DefaultSchema ? ToPascal(name) : ToPascal(schema) + ToPascal(name);

    private static string ResolveConnectionString(string fromOptions)
    {
        // 1) variável de ambiente (recomendado: evita segredo na linha de comando)
        var fromEnvironment = Environment.GetEnvironmentVariable("NEXTHIRE_SCAFFOLD_CONNECTION");
        if (!string.IsNullOrWhiteSpace(fromEnvironment)) return fromEnvironment;

        if (string.IsNullOrWhiteSpace(fromOptions))
            throw new InvalidOperationException(
                "Connection string ausente. Informe-a no comando de scaffold ou defina NEXTHIRE_SCAFFOLD_CONNECTION.");

        if (fromOptions.TrimStart().StartsWith("Name=", StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException(
                "O template não consegue resolver 'Name=...'. Defina NEXTHIRE_SCAFFOLD_CONNECTION com a connection string completa.");

        return fromOptions;
    }

    private static List<PgEnumColumn> LoadEnumColumns(string connectionString, string tableSchema, string tableName)
    {
        const string sql = @"
            SELECT cn.nspname, c.relname, a.attname, tn.nspname, t.typname, a.attnotnull
            FROM pg_catalog.pg_attribute a
            JOIN pg_catalog.pg_class c ON c.oid = a.attrelid
            JOIN pg_catalog.pg_namespace cn ON cn.oid = c.relnamespace
            JOIN pg_catalog.pg_type t ON t.oid = a.atttypid
            JOIN pg_catalog.pg_namespace tn ON tn.oid = t.typnamespace
            WHERE t.typtype = 'e'
              AND a.attnum > 0 AND NOT a.attisdropped
              AND c.relkind IN ('r','p','v','m','f')
              AND cn.nspname = @schema AND c.relname = @table
            ORDER BY a.attnum";

        var result = new List<PgEnumColumn>();

        using (var connection = new NpgsqlConnection(ResolveConnectionString(connectionString)))
        {
            connection.Open();

            using (var command = new NpgsqlCommand(sql, connection))
            {
                command.Parameters.Add(new NpgsqlParameter("schema", tableSchema));
                command.Parameters.Add(new NpgsqlParameter("table", tableName));

                using (var reader = command.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        result.Add(new PgEnumColumn
                        {
                            TableSchema = reader.GetString(0),
                            TableName = reader.GetString(1),
                            ColumnName = reader.GetString(2),
                            EnumSchema = reader.GetString(3),
                            EnumName = reader.GetString(4),
                            NotNull = reader.GetBoolean(5)
                        });
                    }
                }
            }
        }

        return result;
    }
#>
