<#@ template hostSpecific="true" #>
<#@ assembly name="Microsoft.EntityFrameworkCore" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Abstractions" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Design" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Relational" #>
<#@ assembly name="Microsoft.Extensions.DependencyInjection.Abstractions" #>
<#@ assembly name="Npgsql" #>
<#@ parameter name="Model" type="Microsoft.EntityFrameworkCore.Metadata.IModel" #>
<#@ parameter name="Options" type="Microsoft.EntityFrameworkCore.Scaffolding.ModelCodeGenerationOptions" #>
<#@ parameter name="NamespaceHint" type="System.String" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="Microsoft.EntityFrameworkCore" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Design" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Infrastructure" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Metadata" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Scaffolding" #>
<#@ import namespace="Microsoft.Extensions.DependencyInjection" #>
<#@ import namespace="Npgsql" #>
<#
    var services = (IServiceProvider)Host;
    var code = services.GetRequiredService<ICSharpHelper>();
    var annotationCodeGenerator = services.GetRequiredService<IAnnotationCodeGenerator>();

    // ------------------------------------------------------------------
    // 1. Namespaces e pastas
    // ------------------------------------------------------------------
    var modelNamespace = !string.IsNullOrWhiteSpace(Options.ModelNamespace)
        ? Options.ModelNamespace
        : Options.RootNamespace + ".Domains";

    var contextNamespace = !string.IsNullOrWhiteSpace(NamespaceHint)
        ? NamespaceHint
        : (!string.IsNullOrWhiteSpace(Options.ContextNamespace) ? Options.ContextNamespace : Options.RootNamespace + ".Contexts");

    var projectDirectory = string.IsNullOrWhiteSpace(Options.ProjectDir)
        ? Directory.GetCurrentDirectory()
        : Options.ProjectDir;

    // O Options não expõe --output-dir: se usar outra pasta para os modelos, altere aqui.
    var enumsDirectory = Path.Combine(projectDirectory, EnumsRelativeDirectory);
    var contextDirectory = Path.Combine(projectDirectory, Options.ContextDir ?? "");

    // ------------------------------------------------------------------
    // 2. Metadados vindos do catálogo do PostgreSQL
    // ------------------------------------------------------------------
    var connectionString = ResolveConnectionString(Options.ConnectionString);
    var postgresEnums = LoadPostgresEnums(connectionString);
    var enumColumns = LoadEnumColumns(connectionString);

    // ------------------------------------------------------------------
    // 3. Arquivos auxiliares gravados em disco (enums + mapeamento Npgsql)
    // ------------------------------------------------------------------
    Directory.CreateDirectory(enumsDirectory);
    Directory.CreateDirectory(contextDirectory);

    foreach (var pgEnum in postgresEnums)
    {
        var className = EnumClassName(pgEnum.Schema, pgEnum.Name);
        var enumSource = new StringBuilder();

        enumSource.AppendLine("// <auto-generated />");
        enumSource.AppendLine("using NpgsqlTypes;");
        enumSource.AppendLine();
        enumSource.AppendLine("namespace " + modelNamespace + ";");
        enumSource.AppendLine();
        enumSource.AppendLine("public enum " + className);
        enumSource.AppendLine("{");

        var usedNames = new HashSet<string>();

        for (var i = 0; i < pgEnum.Labels.Count; i++)
        {
            var memberName = ToPascal(pgEnum.Labels[i]);

            if (!usedNames.Add(memberName))
            {
                memberName += "_" + i;
                usedNames.Add(memberName);
            }

            enumSource.AppendLine("    [PgName(" + code.Literal(pgEnum.Labels[i]) + ")]");
            enumSource.AppendLine("    " + code.Identifier(memberName) + " = " + i + ",");

            if (i < pgEnum.Labels.Count - 1)
            {
                enumSource.AppendLine();
            }
        }

        enumSource.AppendLine("}");

        WriteIfChanged(Path.Combine(enumsDirectory, className + ".cs"), enumSource.ToString());
    }

    // Extensão usada no Program.cs: o MapEnum precisa estar no UseNpgsql(...).
    var mapping = new StringBuilder();

    mapping.AppendLine("// <auto-generated />");
    mapping.AppendLine("using Npgsql.EntityFrameworkCore.PostgreSQL.Infrastructure;");
    mapping.AppendLine("using " + modelNamespace + ";");
    mapping.AppendLine();
    mapping.AppendLine("namespace " + contextNamespace + ";");
    mapping.AppendLine();
    mapping.AppendLine("public static class PostgresEnumMappings");
    mapping.AppendLine("{");
    mapping.AppendLine("    public static NpgsqlDbContextOptionsBuilder MapPostgresEnums(this NpgsqlDbContextOptionsBuilder builder)");
    mapping.AppendLine("    {");

    foreach (var pgEnum in postgresEnums)
    {
        mapping.AppendLine(
            "        builder.MapEnum<global::" + modelNamespace + "." + EnumClassName(pgEnum.Schema, pgEnum.Name) + ">("
            + code.Literal(pgEnum.Name) + ", " + code.Literal(pgEnum.Schema) + ");");
    }

    mapping.AppendLine();
    mapping.AppendLine("        return builder;");
    mapping.AppendLine("    }");
    mapping.AppendLine("}");

    WriteIfChanged(Path.Combine(contextDirectory, "PostgresEnumMappings.cs"), mapping.ToString());

    var entityTypes = Model.GetEntityTypes()
        .Where(e => !e.IsSimpleManyToManyJoinEntityType())
        .ToList();
#>
// <auto-generated />
// Enums do PostgreSQL encontrados: <#= postgresEnums.Count #>. Gravados em: <#= enumsDirectory #>
using System;
using System.Collections.Generic;
using Microsoft.EntityFrameworkCore;
<#
    if (modelNamespace != contextNamespace)
    {
#>
using <#= modelNamespace #>;
<#
    }
#>

namespace <#= contextNamespace #>;

public partial class <#= Options.ContextName #> : DbContext
{
    public <#= Options.ContextName #>()
    {
    }

    public <#= Options.ContextName #>(DbContextOptions<<#= Options.ContextName #>> options)
        : base(options)
    {
    }

<#
    foreach (var entityType in entityTypes)
    {
#>
    public virtual DbSet<<#= entityType.Name #>> <#= entityType.GetDbSetName() #> { get; set; }

<#
    }

    if (!Options.SuppressOnConfiguring)
    {
#>
    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        // Só roda quando o contexto NÃO foi configurado via AddDbContext.
        if (!optionsBuilder.IsConfigured)
        {
            optionsBuilder.UseNpgsql(
                <#= code.Literal(Options.ConnectionString) #>,
                npgsql =>
                {
<#
    foreach (var pgEnum in postgresEnums)
    {
#>
                    npgsql.MapEnum<global::<#= modelNamespace #>.<#= EnumClassName(pgEnum.Schema, pgEnum.Name) #>>(
                        <#= code.Literal(pgEnum.Name) #>,
                        <#= code.Literal(pgEnum.Schema) #>);
<#
    }
#>
                });
        }
    }

<#
    }
#>
    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
<#
    foreach (var pgEnum in postgresEnums)
    {
#>
        modelBuilder.HasPostgresEnum<global::<#= modelNamespace #>.<#= EnumClassName(pgEnum.Schema, pgEnum.Name) #>>(<#= code.Literal(pgEnum.Schema) #>, <#= code.Literal(pgEnum.Name) #>);
<#
    }

    if (postgresEnums.Count > 0)
    {
#>

<#
    }

    foreach (var entityType in entityTypes)
    {
        var key = entityType.FindPrimaryKey();
        var entityTableName = entityType.GetTableName();
        var entityViewName = entityType.GetViewName();
        var entitySchema = entityType.GetSchema();
        var schemaArgument = entitySchema == null ? "" : ", " + code.Literal(entitySchema);
        var tableEnumColumns = enumColumns
            .Where(c => c.TableName == entityTableName && c.TableSchema == (entitySchema ?? DefaultSchema))
            .ToList();
#>
        modelBuilder.Entity<<#= entityType.Name #>>(entity =>
        {
<#
        if (key != null)
        {
            var keyName = key.GetName();
            var keyNameCall = string.IsNullOrEmpty(keyName) ? "" : ".HasName(" + code.Literal(keyName) + ")";
#>
            entity.HasKey(<#= code.Lambda(key.Properties, "e") #>)<#= keyNameCall #>;
<#
        }
        else
        {
#>
            entity.HasNoKey();
<#
        }

        if (entityTableName != null)
        {
#>
            entity.ToTable(<#= code.Literal(entityTableName) #><#= schemaArgument #>);
<#
        }
        else if (entityViewName != null)
        {
#>
            entity.ToView(<#= code.Literal(entityViewName) #><#= schemaArgument #>);
<#
        }
#>

<#
        foreach (var index in entityType.GetIndexes())
        {
            var uniqueCall = index.IsUnique ? ".IsUnique()" : "";
#>
            entity.HasIndex(<#= code.Lambda(index.Properties, "e") #>, <#= code.Literal(index.GetDatabaseName()) #>)<#= uniqueCall #>;
<#
        }

        foreach (var property in entityType.GetProperties())
        {
            var propertyCalls = property.GetFluentApiCalls(annotationCodeGenerator);

            if (propertyCalls != null)
            {
#>
            entity.Property(e => e.<#= property.Name #>)<#= code.Fragment(propertyCalls, indent: 4) #>;
<#
            }
        }

        // Colunas enum: o scaffold não as conhece, então o nome da coluna
        // precisa ser informado aqui (senão o EF procuraria "TipoUsuario").
        foreach (var column in tableEnumColumns)
        {
            var propertyName = ToPascal(column.ColumnName);

            if (entityType.GetProperties().Any(p => p.Name == propertyName))
            {
                continue;
            }
#>
            entity.Property(e => e.<#= code.Identifier(propertyName) #>).HasColumnName(<#= code.Literal(column.ColumnName) #>);
<#
        }
#>

<#
        foreach (var foreignKey in entityType.GetForeignKeys())
        {
            var dependentNavigation = foreignKey.DependentToPrincipal;

            if (dependentNavigation == null)
            {
                continue;
            }

            var principalNavigation = foreignKey.PrincipalToDependent;
            var withArgument = principalNavigation != null ? "p => p." + principalNavigation.Name : "";
            var withCall = foreignKey.IsUnique ? "WithOne" : "WithMany";
            var foreignKeyCall = foreignKey.IsUnique
                ? "HasForeignKey<" + entityType.Name + ">"
                : "HasForeignKey";
            var constraintName = foreignKey.GetConstraintName();
            var constraintCall = string.IsNullOrEmpty(constraintName) ? "" : ".HasConstraintName(" + code.Literal(constraintName) + ")";
#>
            entity.HasOne(d => d.<#= dependentNavigation.Name #>).<#= withCall #>(<#= withArgument #>)
                .<#= foreignKeyCall #>(<#= code.Lambda(foreignKey.Properties, "d") #>)
                .OnDelete(DeleteBehavior.<#= foreignKey.DeleteBehavior #>)<#= constraintCall #>;

<#
        }

        // Relações N:N: uma única vez por par (lado "esquerdo" decidido por ordem de nome).
        foreach (var skipNavigation in entityType.GetSkipNavigations().Where(IsLeftSide))
        {
            var inverse = skipNavigation.Inverse;
            var joinType = skipNavigation.JoinEntityType;
            var joinKey = joinType.FindPrimaryKey();
            var joinKeyName = joinKey == null ? null : joinKey.GetName();
            var joinTable = joinType.GetTableName();
            var joinSchema = joinType.GetSchema();
            var joinSchemaArgument = joinSchema == null ? "" : ", " + code.Literal(joinSchema);

            var targetForeignKey = inverse.ForeignKey;     // junção -> entidade alvo
            var declaringForeignKey = skipNavigation.ForeignKey; // junção -> esta entidade

            var targetConstraint = targetForeignKey.GetConstraintName();
            var declaringConstraint = declaringForeignKey.GetConstraintName();
#>
            entity.HasMany(d => d.<#= skipNavigation.Name #>).WithMany(p => p.<#= inverse.Name #>)
                .UsingEntity<Dictionary<string, object>>(
                    <#= code.Literal(joinType.Name) #>,
                    l => l.HasOne<<#= skipNavigation.TargetEntityType.Name #>>().WithMany()
                        .HasForeignKey(<#= string.Join(", ", targetForeignKey.Properties.Select(p => code.Literal(p.Name))) #>)
                        .OnDelete(DeleteBehavior.<#= targetForeignKey.DeleteBehavior #>)<#= string.IsNullOrEmpty(targetConstraint) ? "" : ".HasConstraintName(" + code.Literal(targetConstraint) + ")" #>,
                    r => r.HasOne<<#= entityType.Name #>>().WithMany()
                        .HasForeignKey(<#= string.Join(", ", declaringForeignKey.Properties.Select(p => code.Literal(p.Name))) #>)
                        .OnDelete(DeleteBehavior.<#= declaringForeignKey.DeleteBehavior #>)<#= string.IsNullOrEmpty(declaringConstraint) ? "" : ".HasConstraintName(" + code.Literal(declaringConstraint) + ")" #>,
                    j =>
                    {
<#
            if (joinKey != null)
            {
#>
                        j.HasKey(<#= string.Join(", ", joinKey.Properties.Select(p => code.Literal(p.Name))) #>)<#= string.IsNullOrEmpty(joinKeyName) ? "" : ".HasName(" + code.Literal(joinKeyName) + ")" #>;
<#
            }

            if (joinTable != null)
            {
#>
                        j.ToTable(<#= code.Literal(joinTable) #><#= joinSchemaArgument #>);
<#
            }

            foreach (var joinProperty in joinType.GetProperties())
            {
#>
                        j.IndexerProperty<<#= code.Reference(joinProperty.ClrType) #>>(<#= code.Literal(joinProperty.Name) #>).HasColumnName(<#= code.Literal(joinProperty.GetColumnName()) #>);
<#
            }
#>
                    });

<#
        }
#>
        });

<#
    }
#>
        OnModelCreatingPartial(modelBuilder);
    }

    partial void OnModelCreatingPartial(ModelBuilder modelBuilder);
}
<#+
    // =====================================================================
    // Auxiliares (EntityType.t4 contém uma cópia de ToPascal/EnumClassName/
    // ResolveConnectionString: mantenha as duas em sincronia).
    // =====================================================================

    private const string DefaultSchema = "public";

    // Pasta (relativa ao projeto) onde as classes enum são gravadas.
    // Deve coincidir com o --output-dir do scaffold.
    private const string EnumsRelativeDirectory = "Domains";

    private sealed class PgEnumInfo
    {
        public string Schema { get; set; } = "";
        public string Name { get; set; } = "";
        public List<string> Labels { get; } = new List<string>();
    }

    private sealed class PgEnumColumn
    {
        public string TableSchema { get; set; } = "";
        public string TableName { get; set; } = "";
        public string ColumnName { get; set; } = "";
        public string EnumSchema { get; set; } = "";
        public string EnumName { get; set; } = "";
        public bool NotNull { get; set; }
    }

    // Decide qual lado de um par de skip navigations emite o HasMany/WithMany.
    private static bool IsLeftSide(ISkipNavigation navigation)
    {
        var inverse = navigation.Inverse;
        var byType = string.CompareOrdinal(navigation.DeclaringEntityType.Name, inverse.DeclaringEntityType.Name);

        return byType < 0
            || (byType == 0 && string.CompareOrdinal(navigation.Name, inverse.Name) <= 0);
    }

    private static string ToPascal(string value)
    {
        var parts = Regex.Split(value, @"[^\p{L}\p{Nd}]+").Where(x => x.Length > 0);
        var result = string.Concat(parts.Select(x => char.ToUpperInvariant(x[0]) + x.Substring(1)));

        if (result.Length == 0) result = "Value";
        if (char.IsDigit(result[0])) result = "_" + result;

        return result;
    }

    private static string EnumClassName(string schema, string name)
        => schema == DefaultSchema ? ToPascal(name) : ToPascal(schema) + ToPascal(name);

    private static string ResolveConnectionString(string fromOptions)
    {
        var fromEnvironment = Environment.GetEnvironmentVariable("NEXTHIRE_SCAFFOLD_CONNECTION");
        if (!string.IsNullOrWhiteSpace(fromEnvironment)) return fromEnvironment;

        if (string.IsNullOrWhiteSpace(fromOptions))
            throw new InvalidOperationException(
                "Connection string ausente. Informe-a no comando de scaffold ou defina NEXTHIRE_SCAFFOLD_CONNECTION.");

        if (fromOptions.TrimStart().StartsWith("Name=", StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException(
                "O template não consegue resolver 'Name=...'. Defina NEXTHIRE_SCAFFOLD_CONNECTION com a connection string completa.");

        return fromOptions;
    }

    // Grava o arquivo apenas se o conteúdo mudou (evita recompilação em massa).
    private static void WriteIfChanged(string path, string content)
    {
        if (File.Exists(path)
            && string.Equals(File.ReadAllText(path), content, StringComparison.Ordinal))
        {
            return;
        }

        File.WriteAllText(path, content, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
    }

    // Todos os enums do banco, com labels na ordem de criação.
    // Falha RUIDOSAMENTE se não conseguir conectar: silenciar aqui faria o
    // scaffold gerar tudo sem enums e sem classes (o seu sintoma exato).
    private static List<PgEnumInfo> LoadPostgresEnums(string connectionString)
    {
        const string sql = @"
            SELECT n.nspname, t.typname, e.enumlabel, e.enumsortorder
            FROM pg_catalog.pg_type t
            JOIN pg_catalog.pg_namespace n ON n.oid = t.typnamespace
            JOIN pg_catalog.pg_enum e ON e.enumtypid = t.oid
            WHERE t.typtype = 'e'
            ORDER BY n.nspname, t.typname, e.enumsortorder";

        var result = new List<PgEnumInfo>();

        using (var connection = new NpgsqlConnection(ResolveConnectionString(connectionString)))
        {
            connection.Open();

            using (var command = new NpgsqlCommand(sql, connection))
            using (var reader = command.ExecuteReader())
            {
                PgEnumInfo current = null;

                while (reader.Read())
                {
                    var schema = reader.GetString(0);
                    var name = reader.GetString(1);

                    if (current == null || current.Schema != schema || current.Name != name)
                    {
                        current = new PgEnumInfo { Schema = schema, Name = name };
                        result.Add(current);
                    }

                    current.Labels.Add(reader.GetString(2));
                }
            }
        }

        return result;
    }

    // Todas as colunas de tipo enum de todas as tabelas (o scaffold pula essas colunas).
    private static List<PgEnumColumn> LoadEnumColumns(string connectionString)
    {
        const string sql = @"
            SELECT cn.nspname, c.relname, a.attname, tn.nspname, t.typname, a.attnotnull
            FROM pg_catalog.pg_attribute a
            JOIN pg_catalog.pg_class c ON c.oid = a.attrelid
            JOIN pg_catalog.pg_namespace cn ON cn.oid = c.relnamespace
            JOIN pg_catalog.pg_type t ON t.oid = a.atttypid
            JOIN pg_catalog.pg_namespace tn ON tn.oid = t.typnamespace
            WHERE t.typtype = 'e'
              AND a.attnum > 0 AND NOT a.attisdropped
              AND c.relkind IN ('r','p','v','m','f')
            ORDER BY cn.nspname, c.relname, a.attnum";

        var result = new List<PgEnumColumn>();

        using (var connection = new NpgsqlConnection(ResolveConnectionString(connectionString)))
        {
            connection.Open();

            using (var command = new NpgsqlCommand(sql, connection))
            using (var reader = command.ExecuteReader())
            {
                while (reader.Read())
                {
                    result.Add(new PgEnumColumn
                    {
                        TableSchema = reader.GetString(0),
                        TableName = reader.GetString(1),
                        ColumnName = reader.GetString(2),
                        EnumSchema = reader.GetString(3),
                        EnumName = reader.GetString(4),
                        NotNull = reader.GetBoolean(5)
                    });
                }
            }
        }

        return result;
    }
#>