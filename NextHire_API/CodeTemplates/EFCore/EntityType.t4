<#@ template hostSpecific="true" #>
<#@ assembly name="Microsoft.EntityFrameworkCore" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Design" #>
<#@ assembly name="Microsoft.EntityFrameworkCore.Relational" #>
<#@ assembly name="Microsoft.Extensions.DependencyInjection.Abstractions" #>
<#@ parameter name="EntityType" type="Microsoft.EntityFrameworkCore.Metadata.IEntityType" #>
<#@ parameter name="Options" type="Microsoft.EntityFrameworkCore.Scaffolding.ModelCodeGenerationOptions" #>
<#@ parameter name="NamespaceHint" type="System.String" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.ComponentModel.DataAnnotations" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="Microsoft.EntityFrameworkCore" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Design" #>
<#@ import namespace="Microsoft.EntityFrameworkCore.Infrastructure" #>
<#@ import namespace="Microsoft.Extensions.DependencyInjection" #>
<#
    if (!ProductInfo.GetVersion().StartsWith("10.0") && !ProductInfo.GetVersion().StartsWith("9.0") && !ProductInfo.GetVersion().StartsWith("8.0"))
    {
        Warning("Your templates were created using an older version of Entity Framework. Additional features and bug fixes may be available. See https://aka.ms/efcore-docs-updating-templates for more information.");
    }

    var services = (IServiceProvider)Host;
    var annotationCodeGenerator = services.GetRequiredService<IAnnotationCodeGenerator>();
    var code = services.GetRequiredService<ICSharpHelper>();

    var usings = new List<string>
    {
        "System",
        "System.Collections.Generic"
    };

    if (Options.UseDataAnnotations)
    {
        usings.Add("System.ComponentModel.DataAnnotations");
        usings.Add("System.ComponentModel.DataAnnotations.Schema");
    }

    // TRAVA SAFE CONTRA NULLREFERENCE EM USINGS:
    if (EntityType != null)
    {
        foreach (var property in EntityType.GetProperties())
        {
            if (property?.ClrType == null)
            {
                continue;
            }

            var propertyType = property.ClrType;
            if (Nullable.GetUnderlyingType(propertyType) != null)
            {
                propertyType = Nullable.GetUnderlyingType(propertyType);
            }

            if (propertyType.IsPrimitive || propertyType == typeof(string))
            {
                continue;
            }

            var propertyNamespace = propertyType.Namespace;
            if (propertyNamespace != null && !usings.Contains(propertyNamespace))
            {
                usings.Add(propertyNamespace);
            }
        }
    }

    if (!string.IsNullOrEmpty(NamespaceHint))
    {
#>
namespace <#= NamespaceHint #>;

<#
    }

    var entityTypeFluentApiCalls = EntityType?.GetFluentApiCalls(annotationCodeGenerator);
    if (Options.UseDataAnnotations && entityTypeFluentApiCalls != null)
    {
        foreach (var attribute in entityTypeFluentApiCalls.GetAttributes())
        {
#>
<#= code.Fragment(attribute) #>
<#
        }
    }
#>
public partial class <#= EntityType.Name #>
{
<#
    var firstProperty = true;
    foreach (var property in EntityType.GetProperties())
    {
        if (!firstProperty)
        {
            WriteLine("");
        }

        if (Options.UseDataAnnotations)
        {
            var propertyFluentApiCalls = property.GetFluentApiCalls(annotationCodeGenerator);
            if (propertyFluentApiCalls != null)
            {
                foreach (var attribute in propertyFluentApiCalls.GetAttributes())
                {
#>
    <#= code.Fragment(attribute) #>
<#
                }
            }
        }

        string propertyTypeName = property.ClrType != null ? code.Reference(property.ClrType) : "string";

        // Tenta capturar pelo nome do enum Postgres
        var enumAnnotation = property.FindAnnotation("Npgsql:PostgresEnumName");
        string rawEnumName = enumAnnotation?.Value?.ToString();

        // Tenta capturar pelo nome do tipo de coluna no banco (Relational:ColumnType)
        if (string.IsNullOrEmpty(rawEnumName))
        {
            var columnType = property.GetColumnType();
            if (!string.IsNullOrEmpty(columnType) && columnType.EndsWith("_enum", System.StringComparison.OrdinalIgnoreCase))
            {
                rawEnumName = columnType;
            }
            else if (!string.IsNullOrEmpty(property.Name) && property.Name.EndsWith("_enum", System.StringComparison.OrdinalIgnoreCase))
            {
                rawEnumName = property.Name;
            }
        }

        if (!string.IsNullOrEmpty(rawEnumName))
        {
            // Remove schema de nomes como "public.tipo_usuario_enum"
            if (rawEnumName.Contains("."))
            {
                rawEnumName = rawEnumName.Split('.').Last();
            }

            // Converte snake_case para PascalCase
            propertyTypeName = string.Join("", rawEnumName.Split('_').Select(s => char.ToUpper(s[0]) + s.Substring(1)));

            if (property.IsNullable)
            {
                propertyTypeName += "?";
            }
        }
#>
    public <#= propertyTypeName #> <#= property.Name #> { get; set; } = null!;
<#
        firstProperty = false;
    }

    foreach (var navigation in EntityType.GetNavigations())
    {
        WriteLine("");

        var targetType = navigation.TargetEntityType.Name;
        if (navigation.IsCollection)
        {
#>
    public virtual ICollection<<#= targetType #>> <#= navigation.Name #> { get; set; } = new List<<#= targetType #>>();
<#
        }
        else
        {
#>
    public virtual <#= targetType #> <#= navigation.Name #> { get; set; } = null!;
<#
        }
    }

    foreach (var skipNavigation in EntityType.GetSkipNavigations())
    {
        WriteLine("");

        var targetType = skipNavigation.TargetEntityType.Name;
        if (skipNavigation.IsCollection)
        {
#>
    public virtual ICollection<<#= targetType #>> <#= skipNavigation.Name #> { get; set; } = new List<<#= targetType #>>();
<#
        }
        else
        {
#>
    public virtual <#= targetType #> <#= skipNavigation.Name #> { get; set; } = null!;
<#
        }
    }
#>
}