# Copie para .env e preencha. Nunca comite segredos reais.
CONNECTION_STRING=Host=localhost;Port=5432;Username=nexthire;Password=troque;Database=nexthire_db;
REDIS_CONNECTION=localhost:6379
JWT_KEY=troque-por-uma-chave-aleatoria-com-32-bytes-ou-mais
Jwt__Issuer=NextHire_API
Jwt__Audience=NextHire_Client
Jwt__ExpirationTime=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=conta@exemplo.com
SMTP_PASS=app-password
SMTP_FROM=conta@exemplo.com
SMTP_FROM_NAME=NextHire
INTERVIEW_LINK=https://meet.exemplo.com/sala
EMAIL_MILESTONES=10,25,50,100
EMAIL_OUTBOX_INTERVAL_SECONDS=30
